@@ -0,0 +1,18 @@
+import unittest
+from workspace.atomic import Resources
+from workspace.alternatives import purge_permanently
+
+
+class PurgeTests(unittest.TestCase):
+    def test_protected_resource_is_retained(self):
+        store = Resources()
+        store.rows['r'] = {'protected': True}
+        with self.assertRaises(ValueError):
+            purge_permanently(store, 'r')
+        self.assertIn('r', store.rows)
+
+    def test_unprotected_resource_is_permanently_deleted(self):
+        store = Resources()
+        store.rows['r'] = {'protected': False}
+        purge_permanently(store, 'r')
+        self.assertNotIn('r', store.rows)

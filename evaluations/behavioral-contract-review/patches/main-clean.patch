new file mode 100644
index 0000000..2baf8b6
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,27 @@
+import unittest
+from unittest.mock import Mock
+from workspace.alternatives import retry_after_failure
+
+
+class Clock:
+    def __init__(self):
+        self.elapsed = 0
+
+    def sleep(self, seconds):
+        self.elapsed += seconds
+
+
+class RetryTests(unittest.TestCase):
+    def test_fake_clock_backoff(self):
+        clock = Clock()
+        attempts = []
+        def attempt():
+            attempts.append(clock.elapsed)
+            if len(attempts) == 1:
+                raise ConnectionError()
+            return 7
+        operation = Mock(side_effect=attempt)
+        self.assertEqual(retry_after_failure(operation, clock), 7)
+        self.assertEqual(attempts, [0, 1])
+        self.assertEqual(clock.elapsed, 1)
+        self.assertEqual(operation.call_count, 2)

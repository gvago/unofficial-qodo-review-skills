diff --git a/workspace/scoped_records.py b/workspace/scoped_records.py
new file mode 100644
index 0000000..b1a98ff
--- /dev/null
+++ b/workspace/scoped_records.py
@@ -0,0 +1,17 @@
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Artifact:
+    name: str
+    environment: str
+
+
+class ArtifactStore:
+    def __init__(self, rows):
+        self.rows = rows
+
+    def delete_named(self, name, environment):
+        for key, artifact in list(self.rows.items()):
+            if artifact.name == name and artifact.environment == environment:
+                del self.rows[key]

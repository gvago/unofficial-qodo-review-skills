diff --git a/workspace/alternatives.py b/workspace/alternatives.py
new file mode 100644
index 0000000..b944f73
--- /dev/null
+++ b/workspace/alternatives.py
@@ -0,0 +1,29 @@
+from workspace.common import cache_put
+from workspace.atomic import Resources
+from workspace.scoped_records import ArtifactStore
+
+
+def purge_permanently(store: Resources, resource_id):
+    """Explicit permanent purge; unlike archive, restoration is not supported."""
+    if not store.remove_if_unprotected(resource_id):
+        raise ValueError('protected')
+
+
+def scoped_cleanup(store: ArtifactStore, name, environment):
+    store.delete_named(name, environment)
+
+
+def account_key(value):
+    return value.strip().casefold()
+
+
+def save_at(cache, key, value, deadline):
+    cache_put(cache, key, value, expires_at=deadline)
+
+
+def retry_after_failure(operation, clock):
+    try:
+        return operation()
+    except ConnectionError:
+        clock.sleep(1)
+        return operation()
diff --git a/workspace/atomic.py b/workspace/atomic.py
new file mode 100644
index 0000000..3eafd0e
--- /dev/null
+++ b/workspace/atomic.py
@@ -0,0 +1,22 @@
+from threading import Lock
+
+
+class Resources:
+    def __init__(self):
+        self.rows = {}
+        self.lock = Lock()
+
+    def set_protected(self, key, value):
+        with self.lock:
+            self.rows[key]['protected'] = value
+
+    def remove_if_unprotected(self, key):
+        with self.lock:
+            if self.rows[key]['protected']:
+                return False
+            del self.rows[key]
+            return True
+
+
+def apply(resources, planned_key):
+    return resources.remove_if_unprotected(planned_key)
